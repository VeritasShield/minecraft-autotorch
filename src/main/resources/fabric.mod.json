{
  "schemaVersion": 1,
  "id": "autotorch",
  "version": "${version}",
  "name": "Auto Torch Enhanced",
  "description": "Automatically places torches with advanced server-friendly features.",
  "authors": [
    "noteness",
    "VeritasShield"
  ],
  "contact": {
    "homepage": "https://github.com/VeritasShield/minecraft-autotorch",
    "issues": "https://github.com/VeritasShield/minecraft-autotorch/issues",
    "sources": "https://github.com/VeritasShield/minecraft-autotorch"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "assets/autotorch/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "autotorch.autotorch.client.AutotorchClient"
    ],
    "modmenu": [
      "autotorch.autotorch.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "autotorch.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.166.2"
  },
  "suggests": {
    "modmenu": ">=21.0.1"
  }
}